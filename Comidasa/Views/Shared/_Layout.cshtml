<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Comidasa</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/Styles/main.css">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="topbar">
        <div class="container nav-wrap">
            <a href="~/" class="brand">Comidasa</a>
            <nav class="nav-links" aria-label="Navegación principal">
                @{
                    var currentPath = Context.Request.Path.Value ?? "";
                    var isCatalogActive = currentPath == "/" || 
                                          currentPath.Equals("/Home", StringComparison.OrdinalIgnoreCase) || 
                                          currentPath.StartsWith("/Home/Index", StringComparison.OrdinalIgnoreCase) || 
                                          currentPath.StartsWith("/Home/Details", StringComparison.OrdinalIgnoreCase);
                    var isFavoritesActive = currentPath.StartsWith("/Favorites", StringComparison.OrdinalIgnoreCase);
                }
                <a href="~/" class='@(isCatalogActive ? "active" : "")'>Catálogo</a>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a href="~/Favorites" class='@(isFavoritesActive ? "active" : "")'>Mis Favoritos</a>
                }
            </nav>
            <div class="nav-actions">
                <button class="icon-link" type="button" aria-label="Carrito"><span class="material-symbols-outlined">shopping_cart</span></button>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="footer" id="footer">
        <div class="container footer-grid">
            <div>
                <h2>Comidasa</h2>
                <p>Sabor artesanal entregado en la puerta de tu casa. Calidad sin compromisos.</p>
            </div>
            <div>
                <h3>Empresa</h3>
                <a href="#">Sobre nosotros</a>
                <a href="#">Sucursales</a>
            </div>
            <div>
                <h3>Soporte / Dev</h3>
                <a href="#">Contacto</a>
                <a href="/Home/Emails" style="color: #f24c05; font-weight: 700;">Simulador de Correos</a>
                <a href="#">Términos del servicio</a>
            </div>
            <div>
                <h3>Boletín</h3>
                <form class="newsletter">
                    <input type="email" placeholder="Tu email" aria-label="Correo">
                    <button type="button">›</button>
                </form>
            </div>
        </div>
        <div class="footer-bottom">© 2026 Comidasa. Todos los derechos reservados.</div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/Js/navegacion.js"></script>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <script>
            (function () {
                // Temporizador de inactividad (AFK) - 3 minutos (180,000 ms)
                var afkTimeout = 3 * 60 * 1000;
                var afkTimer;

                function resetAfkTimer() {
                    clearTimeout(afkTimer);
                    afkTimer = setTimeout(logoutUserAfk, afkTimeout);
                }

                function logoutUserAfk() {
                    console.log("Usuario AFK detectado. Cerrando sesión...");
                    var logoutForm = document.getElementById('logoutForm');
                    if (logoutForm) {
                        logoutForm.submit();
                    } else {
                        var tempForm = document.createElement('form');
                        tempForm.method = 'post';
                        tempForm.action = '/Identity/Account/Logout?returnUrl=%2F';
                        document.body.appendChild(tempForm);
                        tempForm.submit();
                    }
                }

                var activityEvents = ['mousemove', 'keypress', 'mousedown', 'touchstart', 'scroll'];
                activityEvents.forEach(function (eventName) {
                    document.addEventListener(eventName, resetAfkTimer, true);
                });

                resetAfkTimer();
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
