@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Cambiar Contraseña";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3 style="margin: 0 0 20px; font-size: 24px;">@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="change-password-form" method="post" style="max-width: 450px;">
    <div asp-validation-summary="ModelOnly" class="text-error" role="alert" style="color:red; font-size:12px; margin-bottom:15px;"></div>

    <label asp-for="Input.OldPassword">Contraseña Actual</label>
    <div class="input-box" style="margin-bottom: 5px;">
        <input asp-for="Input.OldPassword" id="oldPassword" type="password" autocomplete="current-password" aria-required="true" placeholder="Ingresa tu contraseña actual" />
        <span class="material-symbols-outlined eye" style="cursor:pointer; font-size:20px;" onclick="togglePassword('oldPassword')">visibility</span>
    </div>
    <span asp-validation-for="Input.OldPassword" class="text-error" style="color:red; font-size:12px; display:block; margin-bottom:15px;"></span>

    <label asp-for="Input.NewPassword">Nueva Contraseña</label>
    <div class="input-box" style="margin-bottom: 5px;">
        <input asp-for="Input.NewPassword" id="newPassword" type="password" autocomplete="new-password" aria-required="true" placeholder="Ingresa tu nueva contraseña" />
        <span class="material-symbols-outlined eye" style="cursor:pointer; font-size:20px;" onclick="togglePassword('newPassword')">visibility</span>
    </div>
    <span asp-validation-for="Input.NewPassword" class="text-error" style="color:red; font-size:12px; display:block; margin-bottom:15px;"></span>

    <label asp-for="Input.ConfirmPassword">Confirmar Contraseña</label>
    <div class="input-box" style="margin-bottom: 5px;">
        <input asp-for="Input.ConfirmPassword" id="confirmPassword" type="password" autocomplete="new-password" aria-required="true" placeholder="Confirma tu nueva contraseña" />
        <span class="material-symbols-outlined eye" style="cursor:pointer; font-size:20px;" onclick="togglePassword('confirmPassword')">visibility</span>
    </div>
    <span asp-validation-for="Input.ConfirmPassword" class="text-error" style="color:red; font-size:12px; display:block; margin-bottom:20px;"></span>

    <button type="submit" class="btn btn-primary">
        Actualizar Contraseña
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(fieldId) {
            const input = document.getElementById(fieldId);
            // find the next sibling which is the span
            const icon = input.nextElementSibling;
            
            if (input && icon) {
                const isPassword = input.type === 'password';
                input.type = isPassword ? 'text' : 'password';
                icon.textContent = isPassword ? 'visibility_off' : 'visibility';
            }
        }
    </script>
}
