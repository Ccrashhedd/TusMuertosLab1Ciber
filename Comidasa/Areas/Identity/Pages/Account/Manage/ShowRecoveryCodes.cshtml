@page
@model ShowRecoveryCodesModel
@{
    ViewData["Title"] = "Códigos de Recuperación";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3 class="font-title-lg text-title-lg text-on-surface mb-6">@ViewData["Title"]</h3>

<div class="bg-error-container text-on-error-container p-6 rounded-xl border border-error/20 mb-6 max-w-2xl">
    <h4 class="font-bold flex items-center gap-2 text-lg mb-2">
        <span class="material-symbols-outlined text-[24px]">warning</span> Guarde estos códigos en un lugar seguro.
    </h4>
    <p class="font-body-md opacity-90 mb-2">
        Si pierde su dispositivo y no tiene los códigos de recuperación, perderá el acceso a su cuenta.
    </p>
</div>

<div class="bg-surface-container-low p-6 rounded-xl border border-surface-variant max-w-sm">
    <div class="grid grid-cols-2 gap-4 text-center font-mono text-lg tracking-widest text-on-surface">
        @for (var row = 0; row < Model.RecoveryCodes.Length; row += 2)
        {
            <div class="bg-white p-2 border border-outline-variant rounded">@Model.RecoveryCodes[row]</div>
            <div class="bg-white p-2 border border-outline-variant rounded">@Model.RecoveryCodes[row + 1]</div>
        }
    </div>
</div>
