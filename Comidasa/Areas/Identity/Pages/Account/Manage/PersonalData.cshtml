@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Datos Personales";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 style="margin: 0 0 20px; font-size: 24px;">@ViewData["Title"]</h3>

<div style="max-width: 550px;">
    <p style="color:var(--muted); line-height:1.6; margin-bottom:20px;">
        Su cuenta contiene datos personales que usted nos ha proporcionado. Esta página le permite descargar o eliminar esos datos.
    </p>
    <div style="background: rgba(211,47,47,0.1); color: #d32f2f; padding: 15px; border-radius: 8px; margin-bottom: 20px; border: 1px solid rgba(211,47,47,0.2);">
        <p style="margin:0; font-weight: 800; display:flex; align-items:flex-start; gap:8px;">
            <span class="material-symbols-outlined" style="margin-top:2px;">warning</span>
            <span>Eliminar sus datos personales borrará permanentemente su cuenta, y no podrá ser recuperada.</span>
        </p>
    </div>
    
    <div style="display:flex; gap:15px; flex-wrap:wrap;">
        <form id="download-data" asp-page="DownloadPersonalData" method="post">
            <button class="btn btn-primary" type="submit">
                Descargar mis datos
            </button>
        </form>
        <a id="delete" asp-page="DeletePersonalData" class="btn btn-outline" style="color: #d32f2f; border-color: #d32f2f;">
            Eliminar Cuenta
        </a>
    </div>
</div>
