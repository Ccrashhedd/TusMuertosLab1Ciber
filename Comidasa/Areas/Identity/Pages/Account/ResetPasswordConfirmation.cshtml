@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Contraseña restablecida";
}

<main class="login-main">
    <section class="container login-grid" style="grid-template-columns: 1fr; max-width: 600px; padding: 120px 0;">
        <div class="login-card" style="text-align: center;">
            <div class="login-icon"><span class="material-symbols-outlined" style="color: #34d399; font-size: 64px;">check_circle</span></div>
            <h2 style="margin-top: 15px;">¡Contraseña actualizada!</h2>
            <p style="margin-bottom: 30px;">Tu contraseña ha sido restablecida exitosamente. Ya puedes iniciar sesión con tu nueva contraseña.</p>

            <a asp-page="./Login" class="btn btn-primary">Iniciar Sesión Ahora</a>
        </div>
    </section>
</main>
