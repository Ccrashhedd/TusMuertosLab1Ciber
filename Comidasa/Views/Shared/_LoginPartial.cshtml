@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" style="margin: 0; display: inline-block;">
        <div style="display: flex; align-items: center; gap: 14px;">
            <a asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage" style="display: flex; align-items: center; gap: 6px; font-weight: 700; color: var(--muted); font-size: 14px;">
                <span class="material-symbols-outlined">person</span>
                <span class="user-email-text">@User.Identity?.Name</span>
            </a>
            <button type="submit" class="btn btn-sm btn-outline">
                Salir
            </button>
        </div>
    </form>
}
else
{
    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-sm btn-primary">Iniciar sesión</a>
}
