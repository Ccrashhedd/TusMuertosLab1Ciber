@page
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Autenticación de Dos Factores (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<h3 class="font-title-lg text-title-lg text-on-surface mb-6">@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="max-w-xl">
    @if (Model.Is2faEnabled)
    {
        if (Model.RecoveryCodesLeft == 0)
        {
            <div class="bg-error-container text-on-error-container p-4 rounded-lg mb-6 shadow-sm">
                <p class="font-bold flex items-center gap-2">
                    <span class="material-symbols-outlined">warning</span> No le quedan códigos de recuperación.
                </p>
                <p>Debe <a asp-page="./GenerateRecoveryCodes" class="underline text-error font-bold">generar nuevos códigos de recuperación</a> antes de poder iniciar sesión con un código.</p>
            </div>
        }
        else if (Model.RecoveryCodesLeft == 1)
        {
            <div class="bg-error-container text-on-error-container p-4 rounded-lg mb-6 shadow-sm">
                <p class="font-bold flex items-center gap-2">
                    <span class="material-symbols-outlined">warning</span> Le queda 1 código de recuperación.
                </p>
                <p>Puede <a asp-page="./GenerateRecoveryCodes" class="underline text-error font-bold">generar nuevos códigos de recuperación</a>.</p>
            </div>
        }
        else if (Model.RecoveryCodesLeft <= 3)
        {
            <div class="bg-surface-variant text-on-surface p-4 rounded-lg mb-6 shadow-sm">
                <p class="font-bold">Le quedan @Model.RecoveryCodesLeft códigos de recuperación.</p>
                <p>Debería <a asp-page="./GenerateRecoveryCodes" class="underline font-bold text-primary">generar nuevos códigos de recuperación</a> pronto.</p>
            </div>
        }

        if (Model.IsMachineRemembered)
        {
            <form method="post" class="inline-block mb-4">
                <button type="submit" class="bg-surface-container-high text-on-surface py-2 px-4 rounded-lg hover:bg-surface-dim transition-all">Olvidar este navegador</button>
            </form>
        }
        
        <div class="flex gap-4 flex-wrap">
            <a asp-page="./Disable2fa" class="bg-error text-on-error py-2 px-4 rounded-lg hover:opacity-90 transition-all">Deshabilitar 2FA</a>
            <a asp-page="./GenerateRecoveryCodes" class="bg-secondary text-on-secondary py-2 px-4 rounded-lg hover:opacity-90 transition-all">Resetear códigos de recuperación</a>
        </div>
    }

    <h4 class="font-title-lg text-on-surface mt-8 mb-4">Aplicación de Autenticación</h4>
    @if (!Model.HasAuthenticator)
    {
        <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="bg-primary text-on-primary py-3 px-6 rounded-lg shadow-md hover:shadow-primary/20 hover:opacity-90 transition-all inline-block">
            Configurar aplicación de autenticación
        </a>
    }
    else
    {
        <div class="flex gap-4 flex-wrap">
            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="bg-primary text-on-primary py-2 px-4 rounded-lg shadow-md hover:opacity-90 transition-all">
                Configurar aplicación de autenticación
            </a>
            <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="bg-surface-variant text-on-surface py-2 px-4 rounded-lg hover:bg-surface-dim transition-all">
                Resetear aplicación de autenticación
            </a>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
