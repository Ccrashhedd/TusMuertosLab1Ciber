@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout !=  null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Views/Shared/_Layout.cshtml";
    }
}

<main class="catalog-section">
    <section class="container">
        <div class="login-card" style="max-width: 1000px; margin: 0 auto; text-align: left;">
            <header style="margin-bottom: 30px; border-bottom: 1px solid var(--surface-3); padding-bottom: 15px;">
                <h1 style="margin: 0; font-size: 32px; color: var(--primary-dark);">Configuración de la Cuenta</h1>
                <p style="margin: 5px 0 0; color: var(--muted);">Gestiona tus datos personales y configuración de seguridad.</p>
            </header>
            
            <div style="display: flex; gap: 40px; flex-wrap: wrap;">
                <div style="flex: 0 0 250px;">
                    <partial name="_ManageNav" />
                </div>
                <div style="flex: 1; min-width: 300px;">
                    @RenderBody()
                </div>
            </div>
        </div>
    </section>
</main>

@section Scripts {
    @RenderSection("Scripts", required: false)
}

@section Styles {
    @RenderSection("Styles", required: false)
}
