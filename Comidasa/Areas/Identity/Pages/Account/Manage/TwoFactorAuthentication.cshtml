@page
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Autenticación de Dos Factores (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<h3 style="margin: 0 0 20px; font-size: 24px;">@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<div style="max-width: 550px;">
    @if (Model.Is2faEnabled)
    {
        if (Model.RecoveryCodesLeft == 0)
        {
            <div style="background: rgba(211,47,47,0.1); color: #d32f2f; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
                <p style="margin:0 0 10px; font-weight: 800; display:flex; align-items:center; gap:8px;">
                    <span class="material-symbols-outlined">warning</span> No le quedan códigos de recuperación.
                </p>
                <p style="margin:0;">Debe <a asp-page="./GenerateRecoveryCodes" style="text-decoration:underline; font-weight:800; color:var(--primary-dark);">generar nuevos códigos</a> antes de poder iniciar sesión con un código.</p>
            </div>
        }
        else if (Model.RecoveryCodesLeft == 1)
        {
            <div style="background: rgba(211,47,47,0.1); color: #d32f2f; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
                <p style="margin:0 0 10px; font-weight: 800; display:flex; align-items:center; gap:8px;">
                    <span class="material-symbols-outlined">warning</span> Le queda 1 código de recuperación.
                </p>
                <p style="margin:0;">Puede <a asp-page="./GenerateRecoveryCodes" style="text-decoration:underline; font-weight:800; color:var(--primary-dark);">generar nuevos códigos</a>.</p>
            </div>
        }
        else if (Model.RecoveryCodesLeft <= 3)
        {
            <div style="background: var(--surface-2); padding: 15px; border-radius: 8px; margin-bottom: 20px;">
                <p style="margin:0 0 5px; font-weight: 800;">Le quedan @Model.RecoveryCodesLeft códigos de recuperación.</p>
                <p style="margin:0;">Debería <a asp-page="./GenerateRecoveryCodes" style="text-decoration:underline; font-weight:800; color:var(--primary-dark);">generar nuevos códigos</a> pronto.</p>
            </div>
        }

        if (Model.IsMachineRemembered)
        {
            <form method="post" style="display:inline-block; margin-bottom:15px;">
                <button type="submit" class="btn btn-sm btn-outline">Olvidar este navegador</button>
            </form>
        }
        
        <div style="display:flex; gap:15px; flex-wrap:wrap;">
            <a asp-page="./Disable2fa" class="btn btn-sm btn-outline" style="color: #d32f2f; border-color: #d32f2f;">Deshabilitar 2FA</a>
            <a asp-page="./GenerateRecoveryCodes" class="btn btn-sm btn-primary">Resetear códigos</a>
        </div>
    }

    <h4 style="margin: 30px 0 15px; font-size: 20px;">Autenticación por Correo Electrónico</h4>
    @if (!Model.Is2faEnabled)
    {
        <form method="post" asp-page-handler="Enable2fa" style="display:inline-block;">
            <button type="submit" class="btn btn-primary">
                Activar Autenticación por Correo
            </button>
        </form>
    }
    else
    {
        <p style="margin-bottom:15px; color:var(--muted); line-height:1.6;">La autenticación de dos factores está activada. Se enviará un código a su correo electrónico al iniciar sesión.</p>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
