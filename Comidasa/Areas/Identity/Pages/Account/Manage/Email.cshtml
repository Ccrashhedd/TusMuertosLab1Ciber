@page
@model EmailModel
@{
    ViewData["Title"] = "Gestionar Correo";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<h3 style="margin: 0 0 20px; font-size: 24px;">@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="email-form" method="post" style="max-width: 450px;">
    <div asp-validation-summary="All" class="text-error" role="alert" style="color:red; font-size:12px; margin-bottom:15px;"></div>
    
    @if (Model.IsEmailConfirmed)
    {
        <label asp-for="Email">Correo Actual</label>
        <div class="input-box" style="margin-bottom: 15px;">
            <input asp-for="Email" type="text" disabled style="background: var(--surface-2); opacity: 0.7;" />
            <span class="material-symbols-outlined eye" style="color:var(--secondary); font-variation-settings: 'FILL' 1;">check_circle</span>
        </div>
    }
    else
    {
        <label asp-for="Email">Correo Actual</label>
        <div class="input-box" style="margin-bottom: 5px;">
            <input asp-for="Email" type="text" disabled style="background: var(--surface-2); opacity: 0.7;" />
        </div>
        <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-sm btn-outline" style="margin-bottom: 15px;">
            Enviar correo de verificación
        </button>
    }

    <label asp-for="Input.NewEmail">Nuevo Correo</label>
    <div class="input-box" style="margin-bottom: 5px;">
        <input asp-for="Input.NewEmail" type="email" placeholder="Ingresa tu nuevo correo." autocomplete="email" aria-required="true" />
    </div>
    <span asp-validation-for="Input.NewEmail" class="text-error" style="color:red; font-size:12px; display:block; margin-bottom:20px;"></span>

    <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-primary">
        Cambiar Correo
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
