@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}

<main class="login-main">
    <section class="container login-grid" style="grid-template-columns: 1fr; max-width: 600px; padding: 120px 0;">
        <div class="login-card">
            <div class="login-icon"><span class="material-symbols-outlined">password</span></div>
            <h2>Elige tu nueva contraseña</h2>
            <p>Ingresa tu correo y la nueva contraseña para tu cuenta.</p>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-error" style="color:red; font-size:12px; margin-bottom: 10px;" role="alert"></div>
                
                <input asp-for="Input.Code" type="hidden" />

                <label asp-for="Input.Email">Correo Electrónico</label>
                <div class="input-box">
                    <span class="material-symbols-outlined">mail</span>
                    <input asp-for="Input.Email" type="email" placeholder="ej. correo@gmail.com" required>
                </div>
                <span asp-validation-for="Input.Email" class="text-error" style="color:red; font-size:12px;"></span>

                <label asp-for="Input.Password">Nueva Contraseña</label>
                <div class="input-box">
                    <span class="material-symbols-outlined">lock</span>
                    <input asp-for="Input.Password" id="password" type="password" placeholder="••••••••" required>
                    <span class="material-symbols-outlined eye" style="cursor:pointer;" onclick="togglePassword('password', 'eye1')" id="eye1">visibility</span>
                </div>
                <span asp-validation-for="Input.Password" class="text-error" style="color:red; font-size:12px;"></span>

                <label asp-for="Input.ConfirmPassword">Confirmar Contraseña</label>
                <div class="input-box">
                    <span class="material-symbols-outlined">lock</span>
                    <input asp-for="Input.ConfirmPassword" id="confirmPassword" type="password" placeholder="••••••••" required>
                    <span class="material-symbols-outlined eye" style="cursor:pointer;" onclick="togglePassword('confirmPassword', 'eye2')" id="eye2">visibility</span>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-error" style="color:red; font-size:12px;"></span>

                <button class="btn btn-primary btn-full" type="submit" style="margin-top: 25px;">Guardar y Restablecer</button>
            </form>

        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(fieldId, iconId) {
            const input = document.getElementById(fieldId);
            const icon = document.getElementById(iconId);
            
            if (input && icon) {
                const isPassword = input.type === 'password';
                input.type = isPassword ? 'text' : 'password';
                icon.textContent = isPassword ? 'visibility_off' : 'visibility';
            }
        }
    </script>
}
