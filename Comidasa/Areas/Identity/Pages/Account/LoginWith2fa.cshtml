@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Autenticación de dos factores";
}

<main class="login-main">
    <section class="container login-grid" style="grid-template-columns: 1fr; max-width: 600px; margin: 0 auto;">
        <div class="login-card">
            <div class="login-icon"><span class="material-symbols-outlined">security</span></div>
            <h2>@ViewData["Title"]</h2>
            <p>Hemos enviado un código de seguridad a su correo electrónico.</p>

            <form method="post">
                <input asp-for="RememberMe" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-error" role="alert" style="color:red; font-size:12px; margin-bottom:15px;"></div>

                <label asp-for="Input.TwoFactorCode">Código de seguridad</label>
                <div class="input-box">
                    <span class="material-symbols-outlined">dialpad</span>
                    <input asp-for="Input.TwoFactorCode" type="text" autocomplete="off" placeholder="123456" required>
                </div>
                <span asp-validation-for="Input.TwoFactorCode" class="text-error" style="color:red; font-size:12px;"></span>

                <div class="form-options">
                    <label class="check">
                        <input asp-for="Input.RememberMachine" type="checkbox"> Recordar esta máquina
                    </label>
                </div>

                <button id="submitBtn" class="btn btn-primary btn-full" type="submit" style="margin-bottom:12px;">Verificar</button>
                <button id="resendBtn" type="submit" formnovalidate asp-page-handler="Resend" class="btn btn-outline btn-full" disabled>
                    Reenviar Código (<span id="timer">60</span>s)
                </button>
            </form>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var timeLeft = 60;
            var timerElement = document.getElementById('timer');
            var resendBtn = document.getElementById('resendBtn');
            var submitBtn = document.getElementById('submitBtn');
            var originalText = "Reenviar Código";

            var countdown = setInterval(function () {
                timeLeft--;
                if (timeLeft <= 0) {
                    clearInterval(countdown);
                    resendBtn.disabled = false;
                    resendBtn.innerHTML = originalText;
                } else {
                    timerElement.textContent = timeLeft;
                }
            }, 1000);
        });
    </script>
}
