@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Verificar Correo";
}

<main class="login-main">
    <section class="container login-grid" style="grid-template-columns: 1fr; max-width: 600px; margin: 0 auto;">
        <div class="login-card">
            <div class="login-icon"><span class="material-symbols-outlined">mark_email_read</span></div>
            <h2>@ViewData["Title"]</h2>
            <p>Hemos enviado un código de 6 dígitos a su correo electrónico (<b>@Model.Email</b>).</p>
            <p>Por favor, introdúzcalo abajo para activar su cuenta.</p>

            <form method="post">
                <input type="hidden" asp-for="Email" />
                <div asp-validation-summary="ModelOnly" class="text-error" role="alert" style="color:red; font-size:12px; margin-bottom:15px;"></div>

                <label asp-for="Code">Código de verificación</label>
                <div class="input-box">
                    <span class="material-symbols-outlined">password</span>
                    <input asp-for="Code" type="text" autocomplete="off" placeholder="123456" required>
                </div>
                <span asp-validation-for="Code" class="text-error" style="color:red; font-size:12px;"></span>

                <button class="btn btn-primary btn-full" type="submit" style="margin-top:20px;">Verificar y Activar Cuenta</button>
            </form>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
