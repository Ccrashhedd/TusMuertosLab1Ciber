@page
@model IndexModel
@{
    ViewData["Title"] = "Perfil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3 style="margin: 0 0 20px; font-size: 24px;">@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="profile-form" method="post" style="max-width: 450px;">
    <div asp-validation-summary="ModelOnly" class="text-error" role="alert" style="color:red; font-size:12px; margin-bottom:15px;"></div>
    
    <label asp-for="Username">Nombre de Usuario</label>
    <div class="input-box" style="margin-bottom: 15px;">
        <input asp-for="Username" type="text" disabled style="background: var(--surface-2); opacity: 0.7;" />
    </div>

    <label asp-for="Input.PhoneNumber">Teléfono</label>
    <div class="input-box" style="margin-bottom: 5px;">
        <input asp-for="Input.PhoneNumber" type="text" placeholder="Ingresa tu teléfono" />
    </div>
    <span asp-validation-for="Input.PhoneNumber" class="text-error" style="color:red; font-size:12px; display:block; margin-bottom:20px;"></span>

    <button id="update-profile-button" type="submit" class="btn btn-primary">
        Guardar Cambios
    </button>
</form>

<!-- Sección de Mis Reseñas -->
<div style="margin-top: 3rem; border-top: 1px solid rgba(229, 190, 179, 0.4); padding-top: 2.5rem; max-width: 800px;">
    <h3 style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 20px; font-weight: 800; color: #a8320e; margin: 0 0 1.5rem 0;">Mis Reseñas Escritas</h3>

    @if (TempData["ErrorMessage"] != null)
    {
        <div style="background-color: #fdf2f2; border: 1px solid #f5b7b1; color: #c0392b; padding: 10px; border-radius: 8px; margin-bottom: 1.5rem; font-size: 13px; font-weight: bold; display: flex; align-items: center; gap: 8px;">
            <span class="material-symbols-outlined" style="font-size:18px;">error</span>
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model.UserReviews == null || !Model.UserReviews.Any())
    {
        <p style="color: #666; font-style: italic;">Aún no has escrito ninguna reseña. ¡Tus opiniones sobre nuestros platos aparecerán aquí!</p>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 1.2rem;">
            @foreach (var review in Model.UserReviews)
            {
                <div class="review-profile-card" id="review-card-@review.Id" style="background: white; border: 1px solid rgba(229, 190, 179, 0.3); border-radius: 12px; padding: 1.2rem; box-shadow: 0 3px 10px rgba(0,0,0,0.01);">
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 8px;">
                        <div>
                            <strong style="color: #a8320e; font-size: 15px;">@review.Product?.NameProduct</strong>
                            <span style="font-size: 11px; color: #999; margin-left: 10px;">@review.CreatedAt.ToString("dd MMM yyyy, HH:mm")</span>
                            @if (!string.IsNullOrEmpty(review.Documento))
                            {
                                <span style="font-size: 11px; background: #f5f5f5; color: #666; padding: 1px 6px; border-radius: 4px; margin-left: 8px;">Doc: @review.Documento</span>
                            }
                        </div>
                        <div style="display: flex; gap: 1px;">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span class="material-symbols-outlined" style="font-size: 14px; color: @(i <= review.Rating ? "#a87b1e" : "#ccc");">star</span>
                            }
                        </div>
                    </div>

                    <!-- Review Display -->
                    <div id="review-display-@review.Id">
                        <p style="color: #555; font-size: 13px; margin: 0 0 10px 0; line-height: 1.4;">@review.Comment</p>
                        
                        @if (!string.IsNullOrEmpty(review.DocumentPath))
                        {
                            <div class="review-attachment-preview" style="margin-top: 0.6rem; margin-bottom: 0.6rem;">
                                @{
                                    var ext = System.IO.Path.GetExtension(review.DocumentPath).ToLower();
                                    if (ext == ".pdf")
                                    {
                                        <a href="@review.DocumentPath" target="_blank" style="display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; border: 1px solid rgba(229, 190, 179, 0.5); border-radius: 6px; background-color: #fdfdfd; text-decoration: none; color: #333; font-size: 12px;">
                                            <span class="material-symbols-outlined" style="color: #c0392b; font-size: 20px;">picture_as_pdf</span>
                                            <span style="font-weight: 600;">Ver Documento PDF</span>
                                        </a>
                                    }
                                    else if (ext == ".jpg" || ext == ".jpeg" || ext == ".png")
                                    {
                                        <div style="border: 1px solid rgba(229, 190, 179, 0.5); border-radius: 6px; padding: 6px; background: #fff; display: inline-block; max-width: 200px; box-shadow: 0 2px 6px rgba(0,0,0,0.05);">
                                            <a href="@review.DocumentPath" target="_blank" style="display: block;">
                                                <img src="@review.DocumentPath" alt="Vista previa del adjunto" style="max-width: 100%; max-height: 120px; border-radius: 4px; display: block; object-fit: contain;" />
                                            </a>
                                        </div>
                                    }
                                }
                            </div>
                        }

                        <div style="display: flex; gap: 8px;">
                            <button type="button" onclick="showEditForm(@review.Id)" class="btn btn-sm btn-outline" style="height: 26px; padding-inline: 10px; font-size: 10px; color: #555; border-color: #ccc;">
                                Editar
                            </button>
                            <form asp-controller="Reviews" asp-action="Delete" asp-route-id="@review.Id" method="post" style="display:inline;" onsubmit="return confirm('¿Estás seguro de que quieres eliminar esta reseña?');">
                                <button type="submit" class="btn btn-sm btn-outline" style="height: 26px; padding-inline: 10px; font-size: 10px; color: #c0392b; border-color: #e74c3c; background: #fdf2f2;">
                                    Eliminar
                                </button>
                            </form>
                            <a href="/Home/Details/@review.ProductId" class="btn btn-sm btn-outline" style="height: 26px; padding-inline: 10px; font-size: 10px; color: var(--muted); border-color: #ddd;">
                                Ir al Plato
                            </a>
                        </div>
                    </div>

                    <!-- Review Edit Form (Hidden by default) -->
                    <div id="review-edit-@review.Id" style="display: none; margin-top: 10px; border-top: 1px dashed rgba(229, 190, 179, 0.4); padding-top: 10px;">
                        <form asp-controller="Reviews" asp-action="Edit" asp-route-id="@review.Id" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="id" value="@review.Id" />
                            
                            <div style="margin-bottom: 10px;">
                                <label style="display:block; font-size: 11px; font-weight:700; margin-bottom:3px;">Calificación:</label>
                                <select name="rating" class="input-select" style="padding: 4px; border-radius: 5px; border: 1px solid #ddd; outline:none; background:white; font-size:12px;">
                                    <option value="5" selected="@(review.Rating == 5)">5 Estrellas</option>
                                    <option value="4" selected="@(review.Rating == 4)">4 Estrellas</option>
                                    <option value="3" selected="@(review.Rating == 3)">3 Estrellas</option>
                                    <option value="2" selected="@(review.Rating == 2)">2 Estrellas</option>
                                    <option value="1" selected="@(review.Rating == 1)">1 Estrella</option>
                                </select>
                            </div>

                            <div style="margin-bottom: 10px;">
                                <label style="display:block; font-size: 11px; font-weight:700; margin-bottom:3px;">Correo electrónico asociado:</label>
                                <input type="text" name="documento" value="@User.Identity.Name" readonly style="width:100%; max-width: 250px; padding: 6px; border-radius: 5px; border: 1px solid #ddd; font-size:12px; background: #f5f5f5; color: #666;" />
                            </div>

                            <div style="margin-bottom: 10px;">
                                <label style="display:block; font-size: 11px; font-weight:700; margin-bottom:3px;">Adjuntar nuevo documento (PDF, JPG, PNG - opcional):</label>
                                <div class="custom-file-upload" style="border: 2px dashed rgba(229, 190, 179, 0.6); border-radius: 8px; padding: 12px; text-align: center; background: #fff; cursor: pointer; transition: all 0.3s ease; position: relative; display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; box-sizing: border-box; overflow: hidden;">
                                    <input type="file" name="documentFile" accept=".pdf, image/png, image/jpeg, image/jpg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer;" onchange="updateFileName(this, 'file-name-display-profile-edit-@review.Id', 'preview-profile-edit-@review.Id')" />
                                    <span class="material-symbols-outlined" style="font-size: 20px; color: #a8320e; flex-shrink: 0;">upload_file</span>
                                    <span id="file-name-display-profile-edit-@review.Id" style="font-size: 12px; color: #666; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 90%;">Seleccionar archivo...</span>
                                </div>
                                
                                <!-- Contenedor de vista previa para archivo nuevo -->
                                <div id="preview-profile-edit-@review.Id" style="display:none; margin-top: 10px; border: 1px solid #ddd5d0; border-radius: 8px; padding: 8px; background: #fff; max-width: 200px; text-align: center; box-shadow: 0 2px 6px rgba(0,0,0,0.05);">
                                    <img src="" alt="Vista previa" style="display:none; max-width:100%; max-height:120px; border-radius: 6px; object-fit: contain; margin: 0 auto;" />
                                    <div style="display:none; align-items:center; justify-content:center; gap:8px; color: #c0392b; padding: 6px;">
                                        <span class="material-symbols-outlined" style="font-size: 28px;">picture_as_pdf</span>
                                        <span style="font-size: 12px; font-weight: bold;">PDF Seleccionado</span>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(review.DocumentPath))
                                {
                                    <div id="file-indicator-@review.Id" style="margin-top: 8px; font-size: 11px; color:#666;">
                                        <div style="margin-bottom: 6px; display: flex; align-items: center; gap: 8px;">
                                            <span>Archivo actual:</span>
                                            <label style="cursor:pointer; color:#c0392b; font-weight:700; display:inline-flex; align-items:center; gap:4px;">
                                                <input type="checkbox" name="keepCurrentFile" value="false" onchange="toggleRemoveFile(@review.Id, this)" /> Eliminar actual
                                            </label>
                                        </div>
                                        <div class="current-file-preview" style="border: 1px solid rgba(229, 190, 179, 0.4); border-radius: 6px; padding: 6px; background: #fafafa; display: inline-block; max-width: 150px;">
                                            @{
                                                var curExt = System.IO.Path.GetExtension(review.DocumentPath).ToLower();
                                                if (curExt == ".pdf")
                                                {
                                                    <a href="@review.DocumentPath" target="_blank" style="display: flex; align-items: center; gap: 6px; text-decoration: none; color: #333;">
                                                        <span class="material-symbols-outlined" style="color: #c0392b; font-size: 20px;">picture_as_pdf</span>
                                                        <span style="font-size: 10px; font-weight: bold;">PDF</span>
                                                    </a>
                                                }
                                                else if (curExt == ".jpg" || curExt == ".jpeg" || curExt == ".png")
                                                {
                                                    <a href="@review.DocumentPath" target="_blank" style="display: block;">
                                                        <img src="@review.DocumentPath" alt="Actual" style="max-width: 100%; max-height: 80px; border-radius: 4px; display: block; object-fit: contain;" />
                                                    </a>
                                                }
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                            <div style="margin-bottom: 10px;">
                                <label style="display:block; font-size: 11px; font-weight:700; margin-bottom:3px;">Comentario:</label>
                                <textarea name="comment" required style="width:100%; min-height: 60px; padding: 8px; border-radius: 5px; border: 1px solid #ddd; font-family:inherit; font-size:12px;">@review.Comment</textarea>
                            </div>

                            <div style="display:flex; gap:8px;">
                                <button type="submit" class="btn btn-sm btn-primary" style="min-height:30px; font-size:11px;">Guardar</button>
                                <button type="button" onclick="hideEditForm(@review.Id)" class="btn btn-sm btn-outline" style="border-color:#ccc; color:#555; min-height:30px; font-size:11px;">Cancelar</button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>

<script>
    function showEditForm(id) {
        $('#review-display-' + id).hide();
        $('#review-edit-' + id).show();
    }

    function hideEditForm(id) {
        $('#review-edit-' + id).hide();
        $('#review-display-' + id).show();
    }

    function toggleRemoveFile(id, checkbox) {
        if (checkbox.checked) {
            $('#file-indicator-' + id).css('text-decoration', 'line-through');
        } else {
            $('#file-indicator-' + id).css('text-decoration', 'none');
        }
    }

    function updateFileName(input, displayId, previewContainerId) {
        var displayEl = document.getElementById(displayId);
        var previewContainer = document.getElementById(previewContainerId);
        if (!displayEl) return;

        // Reset preview elements if container exists
        var imgPreview, pdfPreview;
        if (previewContainer) {
            imgPreview = previewContainer.querySelector('img');
            pdfPreview = previewContainer.querySelector('div');
            
            previewContainer.style.display = 'none';
            if (imgPreview) {
                imgPreview.style.display = 'none';
                imgPreview.src = '';
            }
            if (pdfPreview) {
                pdfPreview.style.display = 'none';
            }
        }

        if (input.files && input.files.length > 0) {
            var file = input.files[0];
            var fileName = file.name;
            var extension = fileName.substring(fileName.lastIndexOf('.')).toLowerCase();
            var allowedExtensions = ['.pdf', '.jpg', '.jpeg', '.png'];

            if (!allowedExtensions.includes(extension)) {
                alert("Solo se permiten archivos PDF o imágenes (JPG, JPEG, PNG). Los archivos de Word u otros formatos no están permitidos.");
                input.value = ""; // Limpiar el input
                displayEl.textContent = "Seleccionar archivo...";
                return;
            }

            displayEl.textContent = fileName;

            // Show preview
            if (previewContainer) {
                previewContainer.style.display = 'block';
                if (extension === '.pdf') {
                    if (pdfPreview) pdfPreview.style.display = 'flex';
                } else {
                    if (imgPreview) {
                        imgPreview.style.display = 'block';
                        imgPreview.src = URL.createObjectURL(file);
                    }
                }
            }
        } else {
            displayEl.textContent = "Seleccionar archivo...";
        }
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


