@page
@model RegisterModel
@{
    ViewData["Title"] = "Registro";
}

<main>
    <section class="registroPage">
        <div class="container registroShell">
            <button class="back-link registroBack" type="button" onclick="location.href='@Url.Content("~/")'">
                <span class="material-symbols-outlined">arrow_back</span>
                Regresar
            </button>

            <div class="registroGrid">
                <aside class="registroAside">
                    <img src="~/Assets/registro.png" alt="Imagen de registro">
                    <h4>Bienvenido a esta aventura gastronomica</h4>
                    <p>Crea tu usuario para mantener tu historial y gustos entre nuestras sucursales</p>
                </aside>
                    
                <div class="registroCard">
                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-error" role="alert" style="color:red; font-size:12px;"></div>

                        <label asp-for="Input.Email">Correo:</label>
                        <input asp-for="Input.Email" type="email" required autocomplete="username" aria-required="true">
                        <span asp-validation-for="Input.Email" class="text-error" style="color:red; font-size:12px;"></span>

                        <label asp-for="Input.Password">Contraseña:</label>
                        <div style="display:flex; align-items:center; gap:8px;">
                            <input asp-for="Input.Password" id="password" type="password" required autocomplete="new-password" aria-required="true" style="flex:1;">
                            <button type="button" id="togglePasswordBtn" onclick="togglePassword('password')">Mostrar</button>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-error" style="color:red; font-size:12px;"></span>

                        <label asp-for="Input.ConfirmPassword">Confirmar Contraseña:</label>
                        <div style="display:flex; align-items:center; gap:8px;">
                            <input asp-for="Input.ConfirmPassword" id="confirmPassword" type="password" required autocomplete="new-password" aria-required="true" style="flex:1;">
                            <button type="button" id="toggleConfirmPasswordBtn" onclick="togglePassword('confirmPassword')">Mostrar</button>
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-error" style="color:red; font-size:12px;"></span>

                        <button type="submit" style="margin-top:20px;">Registrarse</button>
                        
                        <div style="margin-top:15px; font-size:13px;">
                            ¿Ya tienes cuenta? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" style="color:var(--primary-dark); font-weight:800;">Inicia sesión</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(fieldId) {
            const input = document.getElementById(fieldId);
            const btn = document.getElementById(fieldId === 'password' ? 'togglePasswordBtn' : 'toggleConfirmPasswordBtn');
            
            if (input && btn) {
                const isPassword = input.type === 'password';
                input.type = isPassword ? 'text' : 'password';
                btn.textContent = isPassword ? 'Ocultar' : 'Mostrar';
            }
        }
    </script>
}
