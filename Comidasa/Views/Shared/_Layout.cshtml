<!DOCTYPE html>
<html class="light" lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Comidasa</title>
    
    <!-- Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&family=Noto+Serif:ital,wght@0,600;0,700;1,700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "primary": "#9f3c1c",
                        "surface-container-low": "#f1f4f0",
                        "on-error": "#ffffff",
                        "primary-fixed": "#ffdbd1",
                        "surface-tint": "#a23e1e",
                        "surface": "#f7faf5",
                        "error-container": "#ffdad6",
                        "surface-container-lowest": "#ffffff",
                        "secondary-fixed-dim": "#a5d0b9",
                        "error": "#ba1a1a",
                        "on-tertiary-fixed-variant": "#474744",
                        "on-tertiary-container": "#fefcf8",
                        "secondary": "#3f6653",
                        "on-secondary-fixed": "#002114",
                        "secondary-container": "#beead1",
                        "surface-container": "#ecefea",
                        "surface-container-high": "#e6e9e4",
                        "on-error-container": "#93000a",
                        "on-secondary-fixed-variant": "#274e3d",
                        "tertiary-fixed-dim": "#c8c6c3",
                        "on-surface": "#191c1a",
                        "on-secondary": "#ffffff",
                        "tertiary": "#5c5c59",
                        "on-secondary-container": "#436b58",
                        "on-primary-fixed": "#3a0a00",
                        "surface-variant": "#e0e3df",
                        "surface-container-highest": "#e0e3df",
                        "on-primary-fixed-variant": "#822707",
                        "outline": "#8a726b",
                        "primary-fixed-dim": "#ffb59f",
                        "on-primary": "#ffffff",
                        "on-tertiary-fixed": "#1b1c1a",
                        "on-background": "#191c1a",
                        "on-tertiary": "#ffffff",
                        "inverse-primary": "#ffb59f",
                        "outline-variant": "#dec0b8",
                        "surface-bright": "#f7faf5",
                        "secondary-fixed": "#c1ecd4",
                        "background": "#f7faf5",
                        "surface-dim": "#d8dbd6",
                        "inverse-surface": "#2d312e",
                        "inverse-on-surface": "#eff2ed",
                        "on-primary-container": "#fffbff",
                        "tertiary-container": "#757572",
                        "tertiary-fixed": "#e4e2de",
                        "on-surface-variant": "#57423c",
                        "primary-container": "#c05331"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "gutter": "24px",
                        "container-max": "1200px",
                        "margin-desktop": "40px",
                        "margin-mobile": "20px",
                        "base": "8px"
                    },
                    "fontFamily": {
                        "label-sm": ["Plus Jakarta Sans"],
                        "display-lg-mobile": ["Noto Serif"],
                        "headline-md-mobile": ["Noto Serif"],
                        "display-lg": ["Noto Serif"],
                        "body-lg": ["Plus Jakarta Sans"],
                        "title-lg": ["Plus Jakarta Sans"],
                        "headline-md": ["Noto Serif"],
                        "body-md": ["Plus Jakarta Sans"]
                    },
                    "fontSize": {
                        "label-sm": ["14px", {"lineHeight": "20px", "letterSpacing": "0.05em", "fontWeight": "600"}],
                        "display-lg-mobile": ["36px", {"lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "headline-md-mobile": ["28px", {"lineHeight": "36px", "fontWeight": "600"}],
                        "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}],
                        "title-lg": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                        "headline-md": ["32px", {"lineHeight": "40px", "fontWeight": "600"}],
                        "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}]
                    }
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            display: inline-block;
            line-height: 1;
            text-transform: none;
        }
        body {
            background-color: #f7faf5;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #ecefea;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #9f3c1c;
            border-radius: 10px;
        }
        .category-header {
            position: sticky;
            top: 72px;
            z-index: 40;
        }
        .login-mesh {
            background: radial-gradient(circle at 10% 20%, rgba(159, 60, 28, 0.03) 0%, transparent 50%),
                        radial-gradient(circle at 90% 80%, rgba(63, 102, 83, 0.03) 0%, transparent 50%);
        }
        .glass-card { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(8px); }
    </style>
</head>
<body class="font-body-md text-on-surface login-mesh">

    <!-- TopNavBar -->
    <nav class="fixed top-0 w-full z-50 bg-surface/80 dark:bg-surface-dim/80 backdrop-blur-md shadow-sm transition-all duration-300 ease-in-out">
        <div class="flex justify-between items-center px-margin-desktop py-4 max-w-container-max mx-auto">
            <a href="/" class="font-display-lg text-display-lg text-primary italic">Sabor & Brasa</a>
            <div class="hidden md:flex gap-8 items-center">
                <a class="font-title-lg text-title-lg text-primary border-b-2 border-primary font-bold" href="/">Menú</a>
                <a class="font-title-lg text-title-lg text-on-surface-variant hover:text-primary hover:opacity-80 transition-opacity" href="#">Nosotros</a>
                <a class="font-title-lg text-title-lg text-on-surface-variant hover:text-primary hover:opacity-80 transition-opacity" href="#">Contacto</a>
            </div>
            <div class="flex items-center gap-4">
                <button class="material-symbols-outlined text-on-surface-variant hover:text-primary transition-opacity" data-icon="shopping_cart">shopping_cart</button>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>

    <!-- SideNavBar (Shopping Cart) -->
    <aside class="fixed right-0 top-0 h-full w-96 z-[60] bg-surface-container-lowest shadow-2xl flex flex-col p-6 transform translate-x-full transition-transform duration-500 ease-in-out" id="side-nav">
        <div class="flex justify-between items-center mb-8">
            <div>
                <h2 class="font-title-lg text-title-lg text-on-surface">Carrito de Compras</h2>
                <p class="font-body-md text-body-md text-on-surface-variant">Gestiona tus platos</p>
            </div>
            <button class="material-symbols-outlined" onclick="document.getElementById('side-nav').classList.add('translate-x-full')">close</button>
        </div>
        <div class="flex-grow overflow-y-auto custom-scrollbar space-y-6 pr-2">
            <div class="flex gap-4 items-center">
                <div class="flex-grow">
                    <p class="font-bold text-on-surface">No hay productos</p>
                    <p class="text-secondary font-semibold text-sm">El carrito está vacío por ahora.</p>
                </div>
            </div>
        </div>
        <div class="mt-8 pt-6 border-t border-surface-variant space-y-4">
            <div class="flex justify-between font-bold text-title-lg">
                <span>Total</span>
                <span class="text-primary">$0.00</span>
            </div>
            <button class="w-full bg-primary text-on-primary py-4 rounded-lg font-title-lg text-title-lg hover:opacity-90 transition-all shadow-md">Confirmar Pedido</button>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-grow pt-20">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="w-full mt-auto bg-surface-container-highest">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter px-margin-desktop py-12 max-w-container-max mx-auto">
            <div>
                <div class="font-headline-md text-headline-md text-primary mb-6">Sabor & Brasa</div>
                <p class="font-body-sm text-body-sm text-on-surface-variant max-w-xs">Cocinamos con alma, respetando el ciclo de la naturaleza y el origen de cada ingrediente.</p>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div class="space-y-4">
                    <h4 class="font-bold text-on-surface uppercase text-xs tracking-widest">Explora</h4>
                    <ul class="space-y-2 font-body-sm text-on-surface-variant">
                        <li><a class="hover:text-primary transition-colors" href="#">Menú</a></li>
                        <li><a class="hover:text-primary transition-colors" href="#">Nosotros</a></li>
                    </ul>
                </div>
                <div class="space-y-4">
                    <h4 class="font-bold text-on-surface uppercase text-xs tracking-widest">Legal</h4>
                    <ul class="space-y-2 font-body-sm text-on-surface-variant">
                        <li><a class="hover:text-primary transition-colors" href="#">Privacidad</a></li>
                        <li><a class="hover:text-primary transition-colors" href="#">Términos</a></li>
                    </ul>
                </div>
            </div>
            <div>
                <h4 class="font-bold text-on-surface uppercase text-xs tracking-widest mb-4">Newsletter</h4>
                <div class="flex gap-2">
                    <input class="bg-surface-container-low border-none rounded-lg px-4 py-2 flex-grow focus:ring-1 focus:ring-primary text-sm" placeholder="Tu correo" type="email"/>
                    <button class="bg-secondary text-white px-4 py-2 rounded-lg font-bold text-sm">Unirse</button>
                </div>
                <div class="mt-8 text-on-surface-variant font-body-sm text-body-sm">
                    © 2024 Sabor & Brasa. Todos los derechos reservados.
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script>
        // Sticky Header micro-interaction
        window.addEventListener('scroll', () => {
            const nav = document.querySelector('nav');
            if (window.scrollY > 50) {
                nav.classList.add('py-2');
                nav.classList.remove('py-4');
            } else {
                nav.classList.add('py-4');
                nav.classList.remove('py-2');
            }
        });

        // Toggle Cart
        const cartBtn = document.querySelector('[data-icon="shopping_cart"]');
        if (cartBtn) {
            cartBtn.addEventListener('click', () => {
                document.getElementById('side-nav').classList.toggle('translate-x-full');
            });
        }
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
