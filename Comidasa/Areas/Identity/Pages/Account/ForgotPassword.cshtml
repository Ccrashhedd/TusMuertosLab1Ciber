@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "¿Olvidaste tu contraseña?";
}

<main class="login-main">
    <section class="container login-grid" style="grid-template-columns: 1fr; max-width: 600px; padding: 120px 0;">
        <div class="login-card">
            <div class="login-icon"><span class="material-symbols-outlined">lock_reset</span></div>
            <h2>Recupera tu acceso</h2>
            <p>Ingresa tu correo para restablecer tu contraseña.</p>

            @if (Model.ShowLink && !string.IsNullOrEmpty(Model.ResetLink))
            {
                <div style="background-color: #d1fae5; border: 1px solid #34d399; padding: 20px; border-radius: 8px; margin-top: 20px; text-align: center;">
                    <p style="color: #065f46; font-weight: 600; margin-bottom: 15px;">¡Enlace generado exitosamente!</p>
                    <a href="@Model.ResetLink" class="btn btn-primary" style="display: inline-block;">Restablecer Contraseña Ahora</a>
                </div>
            }
            else
            {
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-error" style="color:red; font-size:12px; margin-bottom: 10px;" role="alert"></div>

                    <label asp-for="Input.Email">Correo Electrónico</label>
                    <div class="input-box">
                        <span class="material-symbols-outlined">mail</span>
                        <input asp-for="Input.Email" type="email" placeholder="ej. correo@gmail.com" required>
                    </div>
                    <span asp-validation-for="Input.Email" class="text-error" style="color:red; font-size:12px;"></span>

                    <button class="btn btn-primary btn-full" type="submit" style="margin-top: 25px;">Generar enlace de recuperación</button>
                </form>
            }

            <div class="register-line"><a asp-page="./Login">Volver al Inicio de Sesión</a></div>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
