@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Eliminar Datos Personales";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 style="font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; color: #1a1a1a;">@ViewData["Title"]</h3>

<div class="alert alert-warning" role="alert" style="background-color: #fff3cd; color: #856404; border-radius: 8px; padding: 1rem; margin-bottom: 1.5rem;">
    <p style="margin: 0;">
        <strong>Al eliminar estos datos, se cerrará tu cuenta de forma permanente y no se podrá recuperar.</strong>
    </p>
</div>

<div>
    <form id="delete-user" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        @if (Model.RequirePassword)
        {
            <div class="form-group mb-3">
                <label asp-for="Input.Password" class="form-label" style="font-weight: 700; color: #1a1a1a;">Contraseña</label>
                <input asp-for="Input.Password" class="input-field" style="width: 100%; padding: 0.8rem; border: 1px solid #ddd; border-radius: 8px;" autocomplete="current-password" aria-required="true" placeholder="Por favor, ingresa tu contraseña." />
                <span asp-validation-for="Input.Password" class="text-danger" style="font-size: 0.85rem;"></span>
            </div>
        }
        <button class="btn btn-primary" style="margin-top: 1rem; border-radius: 8px; padding: 0.8rem 1.5rem; font-weight: 700;" type="submit">Eliminar datos y cerrar mi cuenta</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
