@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<main class="login-main">
    <section class="container login-grid">
        <div class="login-copy">
            <h1>Comida caliente<br><span>y fresca en tu puerta.</span></h1>
            <p>Descubre una experiencia culinaria con productos frescos, atención rápida y pedidos fáciles de realizar.</p>
            <img src="~/Assets/plato.png" alt="Plato de comida">
        </div>

        <div class="login-card">
            <div class="login-icon"><span class="material-symbols-outlined">account_circle</span></div>
            <h2>Bienvenido de nuevo</h2>
            <p>Ingresa tus credenciales para continuar</p>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-error" role="alert"></div>

                <label asp-for="Input.Email">Correo Electrónico</label>
                <div class="input-box">
                    <span class="material-symbols-outlined">person</span>
                    <input asp-for="Input.Email" type="text" placeholder="ej. correo@gmail.com" required autocomplete="username" aria-required="true">
                </div>
                <span asp-validation-for="Input.Email" class="text-error" style="color:red; font-size:12px;"></span>

                <label asp-for="Input.Password">Contraseña</label>
                <div class="input-box">
                    <span class="material-symbols-outlined">lock</span>
                    <input asp-for="Input.Password" id="password" type="password" placeholder="••••••••" required autocomplete="current-password" aria-required="true">
                    <span class="material-symbols-outlined eye" style="cursor:pointer;" onclick="togglePassword('password')">visibility</span>
                </div>
                <span asp-validation-for="Input.Password" class="text-error" style="color:red; font-size:12px;"></span>

                <div class="form-options">
                    <label class="check">
                        <input asp-for="Input.RememberMe" type="checkbox"> Recordarme
                    </label>
                    <a asp-page="./ForgotPassword">¿Olvidaste tu contraseña?</a>
                </div>

                <button class="btn btn-primary btn-full" type="submit">Ingresar</button>
            </form>

            <div class="register-line">¿No tienes una cuenta? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Regístrate gratis</a></div>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(fieldId) {
            const input = document.getElementById(fieldId);
            const icon = document.querySelector('.eye');
            
            if (input && icon) {
                const isPassword = input.type === 'password';
                input.type = isPassword ? 'text' : 'password';
                icon.textContent = isPassword ? 'visibility_off' : 'visibility';
            }
        }
    </script>
}
