@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Cambiar Contraseña";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3 class="font-title-lg text-title-lg text-on-surface mb-6">@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="change-password-form" method="post" class="space-y-5 max-w-md">
    <div asp-validation-summary="ModelOnly" class="text-error" role="alert"></div>

    <div class="space-y-1.5">
        <label asp-for="Input.OldPassword" class="font-label-sm text-label-sm text-on-surface-variant block uppercase tracking-wider">Contraseña Actual</label>
        <div class="relative">
            <input asp-for="Input.OldPassword" id="oldPassword" class="w-full bg-surface-container-lowest border-outline-variant focus:border-primary focus:ring-primary/20 rounded-lg py-3 px-4 transition-all" autocomplete="current-password" aria-required="true" placeholder="Ingresa tu contraseña actual" />
            <button class="absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant" type="button" onclick="togglePassword('oldPassword')">
                <span class="material-symbols-outlined text-[20px]" id="oldPasswordIcon">visibility</span>
            </button>
        </div>
        <span asp-validation-for="Input.OldPassword" class="text-error text-sm mt-1"></span>
    </div>

    <div class="space-y-1.5">
        <label asp-for="Input.NewPassword" class="font-label-sm text-label-sm text-on-surface-variant block uppercase tracking-wider">Nueva Contraseña</label>
        <div class="relative">
            <input asp-for="Input.NewPassword" id="newPassword" class="w-full bg-surface-container-lowest border-outline-variant focus:border-primary focus:ring-primary/20 rounded-lg py-3 px-4 transition-all" autocomplete="new-password" aria-required="true" placeholder="Ingresa tu nueva contraseña" />
            <button class="absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant" type="button" onclick="togglePassword('newPassword')">
                <span class="material-symbols-outlined text-[20px]" id="newPasswordIcon">visibility</span>
            </button>
        </div>
        <span asp-validation-for="Input.NewPassword" class="text-error text-sm mt-1"></span>
    </div>

    <div class="space-y-1.5">
        <label asp-for="Input.ConfirmPassword" class="font-label-sm text-label-sm text-on-surface-variant block uppercase tracking-wider">Confirmar Contraseña</label>
        <div class="relative">
            <input asp-for="Input.ConfirmPassword" id="confirmPassword" class="w-full bg-surface-container-lowest border-outline-variant focus:border-primary focus:ring-primary/20 rounded-lg py-3 px-4 transition-all" autocomplete="new-password" aria-required="true" placeholder="Confirma tu nueva contraseña" />
            <button class="absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant" type="button" onclick="togglePassword('confirmPassword')">
                <span class="material-symbols-outlined text-[20px]" id="confirmPasswordIcon">visibility</span>
            </button>
        </div>
        <span asp-validation-for="Input.ConfirmPassword" class="text-error text-sm mt-1"></span>
    </div>

    <button type="submit" class="bg-primary text-on-primary font-title-lg py-3 px-6 rounded-lg shadow-lg hover:shadow-primary/20 hover:opacity-90 transition-all mt-4">
        Actualizar Contraseña
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(fieldId) {
            const input = document.getElementById(fieldId);
            const icon = document.getElementById(fieldId + "Icon");
            
            if (input && icon) {
                const isPassword = input.type === 'password';
                input.type = isPassword ? 'text' : 'password';
                icon.textContent = isPassword ? 'visibility_off' : 'visibility';
            }
        }
    </script>
}
